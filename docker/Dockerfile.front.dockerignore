# =============================================================================
#  Контекст сборки ТОЛЬКО для docker/Dockerfile.front
#
#  BuildKit ПОЛНОСТЬЮ ЗАМЕНЯЕТ этим файлом корневой .dockerignore
#  (не объединяет), поэтому список самодостаточный.
#
#  ВНИМАНИЕ — apps/front/.env ТРОГАТЬ НЕЛЬЗЯ.
#  `.env` без слэша матчит только корневой ./.env. Строка
#     COPY --from=base /app/apps/front/.env ./.env
#  в docker/Dockerfile.front держится на том, что apps/front/.env В КОНТЕКСТЕ.
#  Правила **/.env, */.env, apps/*/.env ЛОМАЮТ ПРОД. Не добавлять.
#
#  Ни одной строки с "!" — исключения отключают срезание каталогов при обходе.
#
#  apps/front зависит от 12 workspace-пакетов, поэтому packages/ остаётся
#  целиком. Вырезан только apps/back — фронт из него ничего не импортирует.
# =============================================================================

# --- Зависимости -------------------------------------------------------------
**/node_modules
**/.pnpm-store
**/.pnp
**/.pnp.js

# --- Артефакты сборки --------------------------------------------------------
**/dist
**/.next
**/out
**/build
**/.turbo
**/.vercel
**/*.tsbuildinfo

# --- VCS / CI ----------------------------------------------------------------
.git
.gitignore
.gitattributes
.github

# --- Секреты (только корневые .env — см. ВНИМАНИЕ выше) ----------------------
.env
.env.*
**/*.pem
**/*.key
**/*.p12
keys
apps/back/keys
apps/front/keys

# --- Runtime-тома из docker-compose.yml --------------------------------------
logs
loki
loki-data
prometheus
promtail

# --- Логи / покрытие ---------------------------------------------------------
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*
**/report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
**/coverage
**/.nyc_output

# --- Документация ------------------------------------------------------------
docs
**/*.md
**/*.docx
**/*.doc
**/*.pdf
**/*.xlsx
todo
oldflow

# --- Локальные dev/ops файлы -------------------------------------------------
Dockerfile
TestDockerfile
docker-compose.yml
docker-compose-full.yml
docker-compose-test.yml
deploy.yml
analyze-time.ps1
desktop.ini
**/.DS_Store
.vscode
.idea
**/*.swp
**/*.swo

# =============================================================================
#  ГЛАВНОЕ ДЛЯ ФРОНТА: бэкенд целиком (564 файла, 2.2 МБ) фронту не нужен
# =============================================================================
apps/back
