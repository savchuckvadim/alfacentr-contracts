# =============================================================================
#  alfacentr :: apps/front (Next.js, standalone)
#  -> ghcr.io/savchuckvadim/alfacentr-front:<sha>
#  Стадии: base -> manifests -> deps -> packages -> build -> prod
#
#  Главное:
#   * Next собирается с output: 'standalone' (apps/front/next.config.js).
#     В .next/standalone лежат server.js и только те файлы node_modules,
#     которые реально нужны серверу. Финальная стадия ничего не ставит.
#     Раньше она делала pnpm install --prod без фильтра и без lock-файла:
#     13 минут на медленном диске сервера и слой почти на гигабайт, экспорт
#     которого ронял сессию buildkit;
#   * .env в образ не попадает. Фронту после сборки переменные окружения не
#     нужны, а единственная переменная, влияющая на бандл,
#     NEXT_PUBLIC_NODE_MODE, приходит через ARG. apps/front/.env вырезан из
#     контекста в Dockerfile.front.dockerignore, поэтому сборка на сервере и
#     в GitHub Actions даёт одинаковый результат;
#   * манифесты копируются ДО установки, --frozen-lockfile, --filter:
#     слой установки переиспользуется, пока не менялись package.json и lock.
#
#  packages/alfa и packages/bx-rq подключаются через main: dist/index.js,
#  а **/dist вырезан из контекста, поэтому оба пакета собираются здесь.
# =============================================================================

FROM node:20 AS base

# Встраивается в бандл при сборке: IS_PROD в modules/app/consts/app-global.ts.
# При development приложение открывает тестовую сделку, поэтому по умолчанию
# production, и в CI значение передаётся явно
ARG NEXT_PUBLIC_NODE_MODE=production
ENV NEXT_PUBLIC_NODE_MODE=${NEXT_PUBLIC_NODE_MODE}

# CI=true — pnpm не спрашивает подтверждений без терминала.
# Путь к хранилищу задан явно, чтобы кеш-монтирование било в него точно.
ENV CI=true \
    NEXT_TELEMETRY_DISABLED=1 \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    npm_config_store_dir=/pnpm/store \
    npm_config_fetch_retries=5 \
    npm_config_fetch_retry_maxtimeout=120000 \
    npm_config_fetch_timeout=600000 \
    npm_config_network_concurrency=8

WORKDIR /app

# Версия строго как в поле packageManager, иначе pnpm догружает сам себя
RUN npm i -g pnpm@10.12.4

# --------------------------------------------------------------- manifests --
FROM base AS manifests

COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc package.json ./
COPY apps/front/package.json                 ./apps/front/package.json
COPY packages/alfa/package.json              ./packages/alfa/package.json
COPY packages/api/package.json               ./packages/api/package.json
COPY packages/bitrix/package.json            ./packages/bitrix/package.json
COPY packages/bx/package.json                ./packages/bx/package.json
COPY packages/bx-rq/package.json             ./packages/bx-rq/package.json
COPY packages/eslint-config/package.json     ./packages/eslint-config/package.json
COPY packages/nest-api/package.json          ./packages/nest-api/package.json
COPY packages/pbx/package.json               ./packages/pbx/package.json
COPY packages/theme/package.json             ./packages/theme/package.json
COPY packages/typescript-config/package.json ./packages/typescript-config/package.json
COPY packages/ui/package.json                ./packages/ui/package.json
COPY packages/ws/package.json                ./packages/ws/package.json

# -------------------------------------------------------------------- deps --
FROM manifests AS deps
RUN --mount=type=cache,id=pnpm-store-alfacentr,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --filter "alfacentr-front..." --reporter=append-only

# ---------------------------------------------------------------- packages --
# Общие пакеты собираются до копирования исходников фронта, чтобы правка
# в apps/front не пересобирала их каждый раз.
FROM deps AS packages

COPY packages ./packages

RUN pnpm --filter "@alfa/entities" run build && \
    pnpm --filter "@workspace/bx-rq" run build && \
    test -f packages/alfa/dist/index.js && \
    test -f packages/bx-rq/dist/index.js

# ------------------------------------------------------------------- build --
FROM packages AS build
ENV NODE_OPTIONS=--max-old-space-size=4096

COPY apps/front ./apps/front

# .next/cache при очистке каталога сборки Next сохраняет, монтировать безопасно.
# Проверяется именно раскладка standalone: server.js лежит по пути монорепо,
# потому что корень трассировки — /app
RUN --mount=type=cache,id=next-cache-front,target=/app/apps/front/.next/cache \
    pnpm --filter alfacentr-front run build && \
    test -f apps/front/.next/standalone/apps/front/server.js && \
    test -d apps/front/.next/static

# -------------------------------------------------------------------- prod --
# Ни pnpm, ни установки. Раскладка повторяет монорепо:
#   /app/apps/front/server.js
#   /app/apps/front/node_modules -> симлинки pnpm в /app/node_modules/.pnpm
# Путь /app обязан совпадать со стадией build: симлинки pnpm копируются как
# есть, а в server.js вписан абсолютный outputFileTracingRoot=/app.
FROM node:20-slim AS prod

# HOSTNAME обязателен: server.js слушает адрес из этой переменной, а Docker
# кладёт в неё id контейнера. Без 0.0.0.0 healthcheck на 127.0.0.1 не пройдёт
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

WORKDIR /app

COPY --from=build /app/apps/front/.next/standalone ./
# standalone не содержит статику (в том числе шрифты next/font) и public
COPY --from=build /app/apps/front/.next/static     ./apps/front/.next/static
COPY --from=build /app/apps/front/public           ./apps/front/public

EXPOSE 3000

# node как PID 1 сам обрабатывает SIGTERM: server.js вешает обработчики,
# поэтому docker stop завершает сервер штатно, а не по таймауту, как с pnpm
CMD ["node", "apps/front/server.js"]
