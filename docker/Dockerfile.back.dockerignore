# =============================================================================
#  Контекст сборки ТОЛЬКО для docker/Dockerfile.back
#
#  BuildKit берёт `<путь-к-dockerfile>.dockerignore`, если он есть, и ПОЛНОСТЬЮ
#  ЗАМЕНЯЕТ им корневой .dockerignore (не объединяет!). Поэтому файл
#  самодостаточный: если убрать отсюда `**/node_modules`, в контекст уедет
#  105 000 файлов зависимостей.
#
#  ВНИМАНИЕ — apps/back/.env ТРОГАТЬ НЕЛЬЗЯ.
#  `.env` без слэша матчит только корневой ./.env. Строка
#     COPY --from=base /app/apps/back/.env ./.env
#  в docker/Dockerfile.back держится на том, что apps/back/.env В КОНТЕКСТЕ.
#  Правила **/.env, */.env, apps/*/.env ЛОМАЮТ ПРОД. Не добавлять.
#
#  Здесь нет ни одной строки с "!" — любое исключение отключает срезание
#  каталогов при обходе дерева (см. корневой .dockerignore).
#
#  apps/back из workspace зависит ТОЛЬКО от @alfa/entities (packages/alfa),
#  в apps/back/src нет ни одного импорта @workspace/*. Поэтому ниже вырезаны
#  apps/front и все фронтовые пакеты: без них root `pnpm install` перестаёт
#  ставить react/three/recharts/radix и прочее в бэкенд-образ.
#  Остаются: packages/alfa (рантайм-зависимость back) и
#  packages/eslint-config + packages/typescript-config — они прописаны в
#  devDependencies КОРНЕВОГО package.json как workspace:*, без них
#  pnpm install упадёт на резолве.
# =============================================================================

# --- Зависимости -------------------------------------------------------------
**/node_modules
**/.pnpm-store
**/.pnp
**/.pnp.js

# --- Артефакты сборки --------------------------------------------------------
**/dist
**/.next
**/out
**/build
**/.turbo
**/.vercel
**/*.tsbuildinfo

# --- VCS / CI ----------------------------------------------------------------
.git
.gitignore
.gitattributes
.github

# --- Секреты (только корневые .env — см. ВНИМАНИЕ выше) ----------------------
.env
.env.*
**/*.pem
**/*.key
**/*.p12
keys
apps/back/keys
apps/front/keys

# --- Runtime-тома из docker-compose.yml (контейнер пишет в них на проде) -----
logs
apps/back/logs
apps/back/storage
apps/back/uploads
apps/back/generated
apps/back/db_data
apps/back/db_dev
apps/back/db_prod
apps/back/loki-data
apps/back/nest-vscode-debugging
loki
loki-data
prometheus
promtail

# --- Логи / покрытие ---------------------------------------------------------
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*
**/report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
**/coverage
**/.nyc_output

# --- Документация ------------------------------------------------------------
docs
**/*.md
**/*.docx
**/*.doc
**/*.pdf
**/*.xlsx
todo
oldflow

# --- Локальные dev/ops файлы -------------------------------------------------
Dockerfile
TestDockerfile
docker-compose.yml
docker-compose-full.yml
docker-compose-test.yml
deploy.yml
analyze-time.ps1
desktop.ini
**/.DS_Store
.vscode
.idea
**/*.swp
**/*.swo

# =============================================================================
#  ГЛАВНОЕ ДЛЯ БЭКЕНДА: всё, что нужно только фронту
# =============================================================================
apps/front

packages/api
packages/bitrix
packages/bx
packages/bx-rq
packages/nest-api
packages/pbx
packages/theme
packages/ui
packages/ws
